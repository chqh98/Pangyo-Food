# 카카오 REST API 키 (필수: 실제 식당 목록, 기준 건물 좌표)
# https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
# 앱 설정 → 제품 설정에서 "카카오맵" 사용 설정 ON 필요
KAKAO_REST_API_KEY=

# 카카오 JavaScript 키 (선택: 사이트에 카카오 지도 표시)
# 같은 앱의 JavaScript 키. 플랫폼 → Web에 사이트 도메인(예: https://xxx.vercel.app, http://localhost:3000) 등록
NEXT_PUBLIC_KAKAO_JS_KEY=

# 네이버 검색 API (선택: 네이버 지도 등록 여부 → 폐업 판단)
# https://developers.naver.com → 애플리케이션 등록 → 사용 API: 검색
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 구글 Places API (New) 키 (선택: 구글 평점·리뷰·영업 상태)
# https://console.cloud.google.com → "Places API (New)" 사용 설정 → 사용자 인증 정보 → API 키 (결제 계정 필요)
GOOGLE_PLACES_API_KEY=
